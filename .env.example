# Copy to .env and fill in. Every variable is read by backend/kothora/config.py.
# Keep comments on their own lines: Docker does not strip trailing comments.
POSTGRES_PASSWORD=
# At least 32 random characters, e.g. from: openssl rand -hex 32
KOTHORA_JWT_SECRET=
# Public API address; SSLCommerz sends the IPN and browser redirects here.
KOTHORA_PUBLIC_URL=https://kothora.example
KOTHORA_FRONTEND_URL=https://kothora.example
KOTHORA_CORS_ORIGINS=["https://kothora.example"]

# Local models (docker compose --profile local-models); pull them once with
#   docker compose exec ollama ollama pull llama3:8b-instruct-q4_K_M
KOTHORA_LOCAL_ENABLED=true
KOTHORA_LOCAL_BASE_URL=http://ollama:11434/v1

# OpenRouter
KOTHORA_OPENROUTER_API_KEY=

# Web search: none | searxng | brave | tavily
KOTHORA_SEARCH_PROVIDER=searxng
KOTHORA_SEARXNG_URL=http://searxng:8080
KOTHORA_BRAVE_API_KEY=
KOTHORA_TAVILY_API_KEY=

# SSLCommerz (cards, bKash, Nagad, Rocket, net banking)
KOTHORA_SSLCOMMERZ_STORE_ID=
KOTHORA_SSLCOMMERZ_STORE_PASSWORD=
KOTHORA_SSLCOMMERZ_SANDBOX=true
