{
  "name": "kothora-chat-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "format": "prettier --write src",
    "lint": "prettier --check src",
    "build:demo": "tsc --noEmit && node scripts/build-demo.mjs",
    "export-plans": "cd .. && backend/.venv/bin/python frontend/scripts/export-plans.py"
  },
  "dependencies": {
    "lucide-solid": "^0.468.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.8.0",
    "vite": "^6.4.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^3.2.7"
  }
}
